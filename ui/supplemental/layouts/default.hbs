<!DOCTYPE html>
<html lang="en">
  <head>
{{> head defaultPageTitle='Untitled'}}
  </head>
  {{!-- `latest` and `next` aliases are pure redirect stubs (not full content pages),
        so they are never indexed by Pagefind. All real versioned pages are indexed
        so users can search across versions and narrow results with the version filter. --}}
  <body class="article{{#with (or page.attributes.role page.role)}} {{{this}}}{{/with}}">
{{!-- Pagefind filter tags: tag every page with its component and version so the
      search modal can offer component/version filter panels. --}}
<span hidden data-pagefind-filter="component[data-value]" data-value="{{page.component.name}}"></span>
{{#if page.version}}<span hidden data-pagefind-filter="version[data-value]" data-value="{{page.version}}"></span>{{/if}}
{{> header}}
{{> body}}
{{> footer}}
  </body>
</html>
